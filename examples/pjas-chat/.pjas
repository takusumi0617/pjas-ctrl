{
  "version": 1,
  "site": {
    "name": "pjas-chat",
    "runtime": "php8.5-fpm",
    "document_root": "dist",
    "https": true,
    "health_path": "/"
  },
  "apache": {
    "file": "deploy/apache.conf",
    "source_root": "/var/www/pjas-chat"
  },
  "shared": ["database"],
  "prepare": ["composer install --no-dev -o", "npm ci", "npm run build"],
  "daemons": [
    {
      "name": "websocket",
      "label": "チャットの即時通知",
      "command": "exec /usr/bin/php8.5 websocket/server.php start",
      "working_directory": ".",
      "start_on_install": true,
      "start_on_boot": true
    }
  ],
  "cron": [
    {
      "name": "expire",
      "label": "期限切れメッセージの削除",
      "schedule": "*/5 * * * *",
      "command": "/usr/bin/php8.5 cron/expire.php",
      "enabled": true
    }
  ]
}
