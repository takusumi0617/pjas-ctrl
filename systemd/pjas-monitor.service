[Unit]
Description=pjas-ctrl monitoring and scheduled publications
After=pjas-agentd.service
[Service]
Type=oneshot
User=pjas-control
Group=pjas-control
SupplementaryGroups=pjas
ExecStart=/usr/bin/php8.5 /opt/pjas-ctrl/bin/pjas-tick
TimeoutStartSec=600
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pjas /var/log/pjas
