[Unit]
Description=pjas-ctrl privileged agent
Documentation=file:/opt/pjas-ctrl/docs/architecture.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/php8.4 /opt/pjas-ctrl/agent/pjas-agentd.php
Restart=always
RestartSec=2

# root で動く唯一のプロセス。書き込めるパスを最小限に絞る。
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
ReadWritePaths=/var/www /etc/apache2/sites-available /etc/apache2/sites-enabled -/var/lib/apache2/site /etc/cron.d /var/log/pjas /var/lib/pjas /run
RuntimeDirectory=pjas
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
