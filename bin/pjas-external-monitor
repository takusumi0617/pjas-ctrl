#!/bin/sh
# Run from the independent monitoring host under the timer.
set -eu
umask 077
if [ "$#" -ne 3 ]; then
    printf '%s\n' 'Usage: pjas-external-monitor HTTPS_URL EXPECTED_STATUS LABEL' >&2
    exit 2
fi
case "$3" in *[!a-zA-Z0-9_.-]*|'') exit 2 ;; esac
state_file=${STATE_DIRECTORY:?}/result
webhook=$(cat "${CREDENTIALS_DIRECTORY:?}/discord-url")
case "$webhook" in
    https://discord.com/api/webhooks/*) ;;
    *) printf '%s\n' 'Invalid Discord webhook' >&2; exit 2 ;;
esac
case "$webhook" in *[!a-zA-Z0-9_:/.-]*) exit 2 ;; esac

if sh "$(dirname "$0")/pjas-external-check" "$1" "$2"; then
    status=up
    message="Service recovered: $3"
else
    code=$?
    if [ "$code" -ne 1 ]; then exit "$code"; fi
    status=down
    message="HTTPS check failed: $3"
fi
previous=up
if [ -f "$state_file" ]; then previous=$(cat "$state_file"); fi
if [ "$previous" = "$status" ]; then exit 0; fi
if ! printf 'url = "%s"\n' "$webhook" |
    curl --disable --config - --silent --fail --noproxy '*' --proto '=https' \
        --connect-timeout 5 --max-time 12 --output /dev/null \
        --header 'Content-Type: application/json' \
        --data "{\"content\":\"$message\",\"allowed_mentions\":{\"parse\":[]}}"; then
    printf '%s\n' 'Discord notification delivery failed' >&2
    exit 1
fi
printf '%s\n' "$status" > "$state_file.tmp"
mv -f "$state_file.tmp" "$state_file"
