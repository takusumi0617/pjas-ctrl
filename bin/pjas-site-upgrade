#!/usr/bin/env php
<?php
declare(strict_types=1);
if (PHP_SAPI === 'cli' && posix_geteuid() === 0 && in_array($argv[1]??'', ['change-status','change-commit','change-rollback'], true)) {
    putenv('PJAS_CONTROL_UPDATE=1');
}
require dirname(__DIR__).'/app/bootstrap.php';
spl_autoload_register(static function(string $class):void{
    if(str_starts_with($class,'Pjas\\Agentd\\Ops\\'))$path=PJAS_ROOT.'/agent/ops/'.substr($class,16).'.php';
    elseif(str_starts_with($class,'Pjas\\Agentd\\'))$path=PJAS_ROOT.'/agent/lib/'.substr($class,12).'.php';
    elseif(str_starts_with($class,'Pjas\\Shared\\'))$path=PJAS_ROOT.'/shared/'.substr($class,12).'.php';else return;
    if(is_file($path))require_once $path;
});
use Pjas\Agentd\{ApacheChange,ChangeTransaction,ControlUpdateChange,ControlUpdate,SiteUpgrade,SiteUpgradeBatch,SiteUpgradeDb,Proc,ControlStore,OpException};
use Pjas\Support\Config;
if(PHP_SAPI!=='cli')exit(77);
try{
    // No elevated operation in this branch. It runs as the existing SQLite file owner.
    if(($argv[1]??'')==='_db'){
        $st=stat((string)Config::get('db'));
        if(!$st||posix_geteuid()!==$st['uid']||posix_geteuid()===0)throw new OpException('管理DBの非root所有者で実行してください');
        $op=$argv[2]??'';$name=$argv[3]??'';
        $result=match($op){'read'=>SiteUpgradeDb::read($name),'write'=>SiteUpgradeDb::change($name,json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR)),default=>throw new OpException('DB操作が不正です')};
        echo json_encode($result,JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)."\n";exit(0);
    }
    $command=$argv[1]??'help';
    if(in_array($command,['help','--help','-h'],true)){
        echo <<<'HELP'
使い方（rootで実行）:
  php8.5 bin/pjas-site-upgrade routing ID --api-front-controller=server/index.php
  php8.5 bin/pjas-site-upgrade jobs SITE
  php8.5 bin/pjas-site-upgrade apache-plan SITE
  php8.5 bin/pjas-site-upgrade change-plan site:ID,batch:ID[,apache:ID][,ctrl:REVIEW_ID]
  php8.5 bin/pjas-site-upgrade change-commit ID --confirm-commit
  php8.5 bin/pjas-site-upgrade change-status ID
  php8.5 bin/pjas-site-upgrade change-prepare ID --accept-standard-apache --external-processes-stopped
  php8.5 bin/pjas-site-upgrade change-rollback ID --confirm-rollback
  php8.5 bin/pjas-site-upgrade batch-plan SITE1,SITE2 --php=8.5 [--api=SITE:server/index.php] [--id-only]
  php8.5 bin/pjas-site-upgrade batch-status ID
  php8.5 bin/pjas-site-upgrade batch-prepare ID --accept-standard-apache --external-processes-stopped
  php8.5 bin/pjas-site-upgrade batch-rollback ID --confirm-rollback
  php8.5 bin/pjas-site-upgrade batch-apply ID --accept-standard-apache --external-processes-stopped --confirm-activation [--skip-manual]
  php8.5 bin/pjas-site-upgrade plan SITE --php=8.5 [--id-only]
  php8.5 bin/pjas-site-upgrade apply ID --accept-standard-apache --external-processes-stopped
  php8.5 bin/pjas-site-upgrade status IDまたはSITE
  php8.5 bin/pjas-site-upgrade activate ID --confirm-activation
  php8.5 bin/pjas-site-upgrade rollback ID --confirm-rollback

plan は常駐unit・cron・PHP変更の計画をroot専用journalへ保存します。
apply は停止・退避・隔離・DB更新を行い、サイトとワーカーを停止状態で維持します。
apply の再実行は再開可能な段階だけを再開します。隔離処理中断時はrollbackを使います。
activate は元々稼働していたワーカーとcron、サイトの公開状態を復帰します。
rollback は公開前の設定・権限・関連付けを復旧し、アプリデータは巻き戻しません。
v2サイトは対象外です。独自Apache設定の標準化と共有FPM再起動を伴います。
HELP;
        echo "\n";exit(0);
    }
    if(posix_geteuid()!==0){fwrite(STDERR,"rootで実行してください。変更は未実施です。\n");exit(77);}
    $cfg=require PJAS_ROOT.'/agent/config.php';$store=new ControlStore($cfg);
    $dbOwner=posix_getpwuid(stat((string)Config::get('db'))['uid']);
    if(!$dbOwner||$dbOwner['uid']===0)throw new OpException('先に管理DBの所有者をpjas-controlへ分離してください');
    $database=static function(string $op,string $name,array $payload)use($dbOwner,$store):array{
        $input=null;
        try{
            if($op==='write'){$input=$store->directory('site-upgrades').'/db-input-'.bin2hex(random_bytes(8));if(file_put_contents($input,json_encode($payload,JSON_THROW_ON_ERROR))===false)throw new OpException('DB入力を作成できません');chmod($input,0600);}
            $r=Proc::run([PHP_BINARY,__FILE__,'_db',$op,$name],null,60,$dbOwner['name'],[], $input);
            if($r['code']!==0)throw new OpException('DB操作に失敗しました: '.trim($r['err']));
            return json_decode($r['out'],true,512,JSON_THROW_ON_ERROR);
        }finally{if($input!==null&&is_file($input))unlink($input);}
    };
    $upgrade=new SiteUpgrade($cfg,$database);$target=$argv[2]??'';$flags=array_slice($argv,3);
    $allowed=match($command){
        'apache-plan','change-plan','change-status'=>[],
        'change-commit'=>['--confirm-commit'],
        'change-prepare'=>['--accept-standard-apache','--external-processes-stopped'],
        'change-rollback'=>['--confirm-rollback'],'routing'=>[],'jobs'=>[],'batch-plan'=>['--id-only'],'batch-status'=>[],'batch-prepare'=>['--accept-standard-apache','--external-processes-stopped'],'batch-rollback'=>['--confirm-rollback'],'batch-apply'=>['--accept-standard-apache','--external-processes-stopped','--confirm-activation','--skip-manual'],'plan'=>['--id-only'],'apply'=>['--accept-standard-apache','--external-processes-stopped'],'activate'=>['--confirm-activation'],'rollback'=>['--confirm-rollback'],'status'=>[],default=>throw new OpException('helpで操作を確認してください')};
    $routing=[];
    if ($command === 'batch-plan') {
        $remaining=[];
        foreach ($flags as $flag) {
            if (!str_starts_with($flag,'--api=')) {
                $remaining[]=$flag;
                continue;
            }
            [$site,$script]=array_pad(explode(':',substr($flag,6),2),2,'');
            if ($site==='' || $script==='' || isset($routing[$site])) throw new OpException('--api=SITE:server/index.php の形式で各サイトを一度だけ指定してください');
            $routing[$site]=$script;
        }
        $flags=$remaining;
    }
    $apiScript='';$runtime='php8.5-fpm';foreach($flags as $flag){if($command==='routing'&&str_starts_with($flag,'--api-front-controller=')){$apiScript=substr($flag,strlen('--api-front-controller='));continue;}if(in_array($command,['plan','batch-plan'],true)&&preg_match('/\A--php=(8\.[0-9]+|static)\z/D',$flag,$m)){$runtime=$m[1]==='static'?'static':'php'.$m[1].'-fpm';continue;}if(!in_array($flag,$allowed,true))throw new OpException('未知のオプションです: '.$flag);}
    $batch=new SiteUpgradeBatch($cfg,$database,static fn(string $op,array $args)=>$upgrade->$op(...$args));
    $apache = new ApacheChange($cfg, $database);
    if (str_starts_with($command,'change-')) {
        $siteOperation=static function(string $operation,string $id) use ($upgrade): array {
            $status=$upgrade->status($id);
            $phase=$status['phase'];
            if ($operation==='check' && $phase!=='planned') throw new OpException('単独移行には未着手の計画が必要です');
            if ($operation==='check-rollback' && $phase==='active') throw new OpException('公開済みサイトは一括復旧できません');
            if ($operation==='prepare') $upgrade->apply($id,true,true);
            if ($operation==='rollback' && !in_array($phase,['planned','rolled-back'],true)) $upgrade->rollback($id,true);
            return [$status['site']];
        };
        $batchOperation=static function(string $operation,string $id) use ($batch): array {
            $sites=$batch->status($id)['sites'];
            foreach ($sites as $name=>$site) {
                $phase=$site['phase'];
                if ($operation==='check' && !in_array($phase,['planned','current'],true)) throw new OpException($name.' / 未着手の一括計画が必要です');
                if ($operation==='check-rollback' && $phase==='active') throw new OpException($name.' / 公開済みサイトは一括復旧できません');
            }
            if ($operation==='prepare') $batch->prepare($id,true,true);
            if ($operation==='rollback') $batch->rollback($id,true);
            return array_keys($sites);
        };
        $preparedSites = static function (array $steps) use ($upgrade, $batch): array {
            $prepared = [];
            foreach ($steps as $step) {
                $sites = match ($step['type']) {
                    'batch' => $batch->status($step['id'])['sites'],
                    default => [],
                };
                if ($step['type'] === 'site') {
                    $status = $upgrade->status($step['id']);
                    $sites = [$status['site']=>$status];
                }
                foreach ($sites as $name => $status) {
                    if ($status['phase'] === 'current') continue;
                    if ($status['phase'] !== 'prepared') throw new OpException($name.' の移行準備が完了していません');
                    $prepared[$name] = $status['id'];
                }
            }
            return $prepared;
        };
        $transaction=new ChangeTransaction($store,['site'=>$siteOperation,'batch'=>$batchOperation,'apache'=>$apache,'ctrl'=>new ControlUpdateChange($store,new ControlUpdate($cfg),$preparedSites)]);
        if ($command==='change-plan') {
            $steps=[];
            foreach (explode(',',$target) as $input) {
                [$type,$id]=array_pad(explode(':',$input,2),2,'');
                if (!preg_match($type==='ctrl'?'/\A[a-f0-9]{32}\z/D':'/\A[a-f0-9]{24}\z/D',$id)) throw new OpException('site:ID、batch:ID apache:ID または ctrl:REVIEW_ID で指定してください');
                $steps[]=['type'=>$type,'id'=>$id];
            }
            $result=$transaction->plan($steps);
        } elseif ($command==='change-status') {
            $result=$transaction->status($target);
        } elseif ($command==='change-commit') {
            if (!in_array('--confirm-commit',$flags,true)) throw new OpException('--confirm-commit が必要です');
            $result=$transaction->commit($target);
        } else {
            $rollback=$command==='change-rollback';
            if ($rollback ? !in_array('--confirm-rollback',$flags,true)
                : array_diff(['--accept-standard-apache','--external-processes-stopped'],$flags)) {
                throw new OpException('操作に必要な確認フラグを指定してください');
            }
            $result=$transaction->run($target,$rollback);
        }
        echo json_encode($result,JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR)."\n";
        exit(($result['control_update']??null)==='failed'?1:0);
    }
    $result=match($command){
        'apache-plan'=>$apache->plan($target),
        'routing'=>$upgrade->routing($target,$apiScript),
        'jobs'=>['site'=>$target,'pending_jobs'=>$database('read',$target,[])['pending_jobs']],
        'batch-plan'=>$batch->plan(explode(',',$target),$runtime,$routing),
        'batch-status'=>$batch->status($target),
        'batch-prepare'=>$batch->prepare($target,in_array('--accept-standard-apache',$flags,true),in_array('--external-processes-stopped',$flags,true)),
        'batch-rollback'=>$batch->rollback($target,in_array('--confirm-rollback',$flags,true)),
        'batch-apply'=>$batch->apply($target,in_array('--accept-standard-apache',$flags,true),in_array('--external-processes-stopped',$flags,true),in_array('--confirm-activation',$flags,true),in_array('--skip-manual',$flags,true)),
        'plan'=>$upgrade->plan($target,$runtime),
        'apply'=>$upgrade->apply($target,in_array('--accept-standard-apache',$flags,true),in_array('--external-processes-stopped',$flags,true)),
        'status'=>$upgrade->status($target),
        'activate'=>$upgrade->activate($target,in_array('--confirm-activation',$flags,true)),
        'rollback'=>$upgrade->rollback($target,in_array('--confirm-rollback',$flags,true)),
    };
    if(in_array($command,['plan','batch-plan'],true)&&in_array('--id-only',$flags,true)){echo $result['id']."\n";exit(0);}
    echo json_encode($result,JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)."\n";
}catch(Throwable $e){fwrite(STDERR,'移行操作を完了できませんでした: '.$e->getMessage()."\n");exit(1);}
